# SQLite-файл создаётся автоматически в prisma/dev.db
DATABASE_URL="file:./dev.db"
# Секрет подписи сессионной cookie (в проде заменить)
AUTH_SECRET="change-me"

# --- Интеграция с облачным порталом Битрикс24 ---------------------------
# Модуль выключен по умолчанию: без BITRIX24_WEBHOOK_URL приложение
# работает как обычно, ни один вызов в портал не уходит.
#
# BITRIX24_WEBHOOK_URL — адрес входящего вебхука портала с секретным токеном.
#   Токен — часть URL, поэтому значение считается секретом: не попадает в git,
#   в логи и в ответы API. Пример формата: https://<portal>/rest/1/<токен>/
BITRIX24_WEBHOOK_URL=""
# BITRIX24_PORTAL_ID — идентификатор портала, показывается в админке.
BITRIX24_PORTAL_ID=""
# BITRIX24_INTEGRATION_SECRET — общий секрет для входящих вебхуков.
#   Передаётся порталом в заголовке x-otklik-secret (или в поле secret тела).
BITRIX24_INTEGRATION_SECRET=""
# BITRIX24_TIMEOUT_MS — таймаут вызова портала в миллисекундах (по умолчанию 8000).
BITRIX24_TIMEOUT_MS="8000"
